# PHP module → local Gateway
SAFEAI_GATEWAY_URL=http://127.0.0.1:8780
SAFEAI_GATEWAY_HMAC_SECRET=replace-with-at-least-32-random-bytes
SAFEAI_RATE_LIMIT_SECRET=replace-with-a-different-32-byte-random-secret

# Shared private queue used by Gateway, Worker and the Bitrix import agent
SAFEAI_QUEUE_ROOT=/var/lib/safeai-b2b/queue
SAFEAI_STORAGE_ROOT=/var/lib/safeai-b2b/storage

# Incoming webhook created in Bitrix24 with CRM scope only
SAFEAI_BITRIX24_WEBHOOK_URL=https://example.bitrix24.ru/rest/1/replace-me
SAFEAI_BITRIX24_ALLOWED_HOST=example.bitrix24.ru

